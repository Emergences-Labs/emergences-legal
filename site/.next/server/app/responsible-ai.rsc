17:["$","div",null,{"className":"mt-10","children":[["$","section","1",{"id":"clause-1","className":"relative scroll-mt-24 border-t border-[var(--border-subtle)] pl-9 pt-7 first:border-t-0 sm:pl-14 [&:not(:first-child)]:mt-9","children":[["$","span",null,{"className":"absolute left-0 top-[1.75rem] font-mono text-[13px] tabular-nums text-[var(--text-muted)] sm:text-[14px]","aria-hidden":true,"children":[1,"."]}],["$","h2",null,{"className":"m-0 font-serif text-[20px] font-bold tracking-[-0.01em] text-[var(--text-primary)]","children":"Intended use — and where it stops"}],[["$","p","The platform is a decision-support tool ",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":"The platform is a decision-support tool for employment assessment. It produces descriptive results about a candidate's demonstrated work, supported by evidence. It is not designed or permitted to be the sole basis of an employment decision, to rank people by protected characteristics, or to make automated hire/reject decisions. Using it that way violates our Acceptable Use Policy."}]]]}],["$","section","2",{"id":"clause-2","className":"relative scroll-mt-24 border-t border-[var(--border-subtle)] pl-9 pt-7 first:border-t-0 sm:pl-14 [&:not(:first-child)]:mt-9","children":[["$","span",null,{"className":"absolute left-0 top-[1.75rem] font-mono text-[13px] tabular-nums text-[var(--text-muted)] sm:text-[14px]","aria-hidden":true,"children":[2,"."]}],["$","h2",null,{"className":"m-0 font-serif text-[20px] font-bold tracking-[-0.01em] text-[var(--text-primary)]","children":"Human oversight"}],[["$","p","Every consequential use keeps a human in",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":"Every consequential use keeps a human in the loop: the employer reviews the evaluation and decides. On our side, evaluation logic is built and changed under review, and outputs flag low-evidence observations for human attention rather than guessing."}]]]}],["$","section","3",{"id":"clause-3","className":"relative scroll-mt-24 border-t border-[var(--border-subtle)] pl-9 pt-7 first:border-t-0 sm:pl-14 [&:not(:first-child)]:mt-9","children":[["$","span",null,{"className":"absolute left-0 top-[1.75rem] font-mono text-[13px] tabular-nums text-[var(--text-muted)] sm:text-[14px]","aria-hidden":true,"children":[3,"."]}],["$","h2",null,{"className":"m-0 font-serif text-[20px] font-bold tracking-[-0.01em] text-[var(--text-primary)]","children":"Fairness and bias mitigation"}],[["$","ul","Assessments are scored against observabl",{"className":"mt-3 list-disc space-y-2 pl-5 text-[14px] leading-[1.75] text-[var(--text-secondary)] marker:text-[var(--brand)]","children":[["$","li","Assessments are scored against observable evidence from the work, using explicit criteria — not overall impression.",{"children":"Assessments are scored against observable evidence from the work, using explicit criteria — not overall impression."}],["$","li","An unobserved behavior is treated as “insufficient evidence”, never as a failure, so quiet or unconventional working styles are not penalized.",{"children":"An unobserved behavior is treated as “insufficient evidence”, never as a failure, so quiet or unconventional working styles are not penalized."}],["$","li","The system does not use, request, or infer protected characteristics, and does not use proxies (such as location) for them.",{"children":"The system does not use, request, or infer protected characteristics, and does not use proxies (such as location) for them."}],"$L1a"]}]]]}],"$L1b","$L1c","$L1d"]}]
