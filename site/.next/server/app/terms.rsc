26:["$","p","Changes to the Platform",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":[["$","span",null,{"className":"mr-1.5 font-mono text-[11.5px] tabular-nums text-[var(--text-muted)]","children":"2.3"}],["$","strong",null,{"className":"font-semibold text-[var(--text-primary)]","children":["Changes to the Platform","."]}]," ","We may improve, modify, or discontinue features from time to time. We will not materially reduce the core functionality of a paid subscription during its paid term without reasonable notice."]}]
27:["$","section","3",{"id":"clause-3","className":"relative scroll-mt-24 border-t border-[var(--border-subtle)] pl-9 pt-7 first:border-t-0 sm:pl-14 [&:not(:first-child)]:mt-9","children":[["$","span",null,{"className":"absolute left-0 top-[1.75rem] font-mono text-[13px] tabular-nums text-[var(--text-muted)] sm:text-[14px]","aria-hidden":true,"children":[3,"."]}],["$","h2",null,{"className":"m-0 font-serif text-[20px] font-bold tracking-[-0.01em] text-[var(--text-primary)]","children":"Customer as employer and deployer"}],[["$","p","The Platform uses AI and automated proce",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":"The Platform uses AI and automated processes to evaluate Candidates and produce descriptive Output. It is a decision-support tool: it does not make hiring decisions and does not label a Candidate “hire” or “no-hire”. The Customer is the employer or employment agency for every Candidate it evaluates and is the sole decision-maker for all employment decisions."}],["$","p","Human review",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":[["$","span",null,{"className":"mr-1.5 font-mono text-[11.5px] tabular-nums text-[var(--text-muted)]","children":"3.1"}],["$","strong",null,{"className":"font-semibold text-[var(--text-primary)]","children":["Human review","."]}]," ","The Customer will apply meaningful human review to every decision, exercise independent judgment, and not use Output as the sole basis for any employment decision. As between the parties, we are the provider of the Platform and the Customer is the deployer that determines the purpose and manner of its use."]}],["$","p","Compliance with employment and AI laws",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":[["$","span",null,{"className":"mr-1.5 font-mono text-[11.5px] tabular-nums text-[var(--text-muted)]","children":"3.2"}],["$","strong",null,{"className":"font-semibold text-[var(--text-primary)]","children":["Compliance with employment and AI laws","."]}]," ","The Customer is responsible for compliance with all laws applicable to its use of the Platform, including anti-discrimination, employment, and automated-employment-decision and AI laws. This includes providing required candidate notices, obtaining any required consent, arranging any required bias audit and public posting, offering reasonable accommodation and an alternative process on request, and monitoring its own selection outcomes. We will provide reasonable documentation to support the Customer's compliance, but do not assume the Customer's legal obligations. This Section is consistent with, and supplemented by, Section 10 of the Fee Terms."]}]]]}]
28:["$","section","4",{"id":"clause-4","className":"relative scroll-mt-24 border-t border-[var(--border-subtle)] pl-9 pt-7 first:border-t-0 sm:pl-14 [&:not(:first-child)]:mt-9","children":[["$","span",null,{"className":"absolute left-0 top-[1.75rem] font-mono text-[13px] tabular-nums text-[var(--text-muted)] sm:text-[14px]","aria-hidden":true,"children":[4,"."]}],["$","h2",null,{"className":"m-0 font-serif text-[20px] font-bold tracking-[-0.01em] text-[var(--text-primary)]","children":"Acceptable use"}],[["$","p","The Customer and its users must comply w",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":"The Customer and its users must comply with the Acceptable Use Policy, which is incorporated by reference. Among other things, the Customer must not use Output as the sole basis for a decision, re-identify or scrape Candidates, misuse the Platform to build a competing product, or submit unlawful content or others' personal data without a lawful basis. We may suspend use that violates the Acceptable Use Policy or poses a security or legal risk."}]]]}]
29:["$","section","5",{"id":"clause-5","className":"relative scroll-mt-24 border-t border-[var(--border-subtle)] pl-9 pt-7 first:border-t-0 sm:pl-14 [&:not(:first-child)]:mt-9","children":[["$","span",null,{"className":"absolute left-0 top-[1.75rem] font-mono text-[13px] tabular-nums text-[var(--text-muted)] sm:text-[14px]","aria-hidden":true,"children":[5,"."]}],["$","h2",null,{"className":"m-0 font-serif text-[20px] font-bold tracking-[-0.01em] text-[var(--text-primary)]","children":"Fees"}],[["$","p","Fees, subscriptions, usage credits, and ",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":"Fees, subscriptions, usage credits, and the placement success fee are governed by the Fee Terms and the Fee Schedule, incorporated by reference. Except as stated there, fees are non-cancelable and non-refundable. If there is a conflict between these Terms and the Fee Terms about billing, the Fee Terms control."}]]]}]
2a:["$","section","6",{"id":"clause-6","className":"relative scroll-mt-24 border-t border-[var(--border-subtle)] pl-9 pt-7 first:border-t-0 sm:pl-14 [&:not(:first-child)]:mt-9","children":[["$","span",null,{"className":"absolute left-0 top-[1.75rem] font-mono text-[13px] tabular-nums text-[var(--text-muted)] sm:text-[14px]","aria-hidden":true,"children":[6,"."]}],["$","h2",null,{"className":"m-0 font-serif text-[20px] font-bold tracking-[-0.01em] text-[var(--text-primary)]","children":"Intellectual property; feedback"}],[["$","p","Our IP",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":[["$","span",null,{"className":"mr-1.5 font-mono text-[11.5px] tabular-nums text-[var(--text-muted)]","children":"6.1"}],["$","strong",null,{"className":"font-semibold text-[var(--text-primary)]","children":["Our IP","."]}]," ","We and our licensors own the Platform and all related intellectual property. Except for the rights expressly granted, no rights are transferred to the Customer."]}],["$","p","Customer Data and Output",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":[["$","span",null,{"className":"mr-1.5 font-mono text-[11.5px] tabular-nums text-[var(--text-muted)]","children":"6.2"}],["$","strong",null,{"className":"font-semibold text-[var(--text-primary)]","children":["Customer Data and Output","."]}]," ","As between the parties, the Customer owns its Customer Data. The Customer may use Output for its internal hiring purposes. The Customer grants us a limited license to host and process Customer Data to provide the Platform and as permitted by the Privacy Policy and DPA."]}],["$","p","Feedback",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":[["$","span",null,{"className":"mr-1.5 font-mono text-[11.5px] tabular-nums text-[var(--text-muted)]","children":"6.3"}],["$","strong",null,{"className":"font-semibold text-[var(--text-primary)]","children":["Feedback","."]}]," ","If the Customer gives us feedback or suggestions, we may use them without restriction or obligation."]}]]]}]
2b:["$","section","7",{"id":"clause-7","className":"relative scroll-mt-24 border-t border-[var(--border-subtle)] pl-9 pt-7 first:border-t-0 sm:pl-14 [&:not(:first-child)]:mt-9","children":[["$","span",null,{"className":"absolute left-0 top-[1.75rem] font-mono text-[13px] tabular-nums text-[var(--text-muted)] sm:text-[14px]","aria-hidden":true,"children":[7,"."]}],["$","h2",null,{"className":"m-0 font-serif text-[20px] font-bold tracking-[-0.01em] text-[var(--text-primary)]","children":"Data protection and privacy"}],[["$","p","Our handling of personal data is describ",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":"Our handling of personal data is described in the Privacy Policy. Where we process personal data on the Customer's behalf, the Data Processing Addendum applies and, if executed, forms part of the Agreement. The Customer is responsible for the lawfulness of the Customer Data it provides and for having any notices and consents its use of the Platform requires."}]]]}]
2c:["$","section","8",{"id":"clause-8","className":"relative scroll-mt-24 border-t border-[var(--border-subtle)] pl-9 pt-7 first:border-t-0 sm:pl-14 [&:not(:first-child)]:mt-9","children":[["$","span",null,{"className":"absolute left-0 top-[1.75rem] font-mono text-[13px] tabular-nums text-[var(--text-muted)] sm:text-[14px]","aria-hidden":true,"children":[8,"."]}],["$","h2",null,{"className":"m-0 font-serif text-[20px] font-bold tracking-[-0.01em] text-[var(--text-primary)]","children":"Confidentiality"}],[["$","p","Each party may access the other's non-pu",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":"Each party may access the other's non-public information. The receiving party will use the disclosing party's confidential information only to perform under the Agreement, protect it with reasonable care, and not disclose it except to representatives bound by confidentiality. This does not apply to information that is public, independently developed, or rightfully received from a third party, or to disclosures required by law."}]]]}]
2d:["$","section","9",{"id":"clause-9","className":"relative scroll-mt-24 border-t border-[var(--border-subtle)] pl-9 pt-7 first:border-t-0 sm:pl-14 [&:not(:first-child)]:mt-9","children":[["$","span",null,{"className":"absolute left-0 top-[1.75rem] font-mono text-[13px] tabular-nums text-[var(--text-muted)] sm:text-[14px]","aria-hidden":true,"children":[9,"."]}],["$","h2",null,{"className":"m-0 font-serif text-[20px] font-bold tracking-[-0.01em] text-[var(--text-primary)]","children":"Third-party services"}],[["$","p","The Platform relies on and may interoper",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":"The Platform relies on and may interoperate with third-party services (for example, our sub-processors and any tools the Customer connects). We are not responsible for third-party services the Customer chooses to connect, and their use is governed by their own terms."}]]]}]
2e:["$","section","10",{"id":"clause-10","className":"relative scroll-mt-24 border-t border-[var(--border-subtle)] pl-9 pt-7 first:border-t-0 sm:pl-14 [&:not(:first-child)]:mt-9","children":[["$","span",null,{"className":"absolute left-0 top-[1.75rem] font-mono text-[13px] tabular-nums text-[var(--text-muted)] sm:text-[14px]","aria-hidden":true,"children":[10,"."]}],["$","h2",null,{"className":"m-0 font-serif text-[20px] font-bold tracking-[-0.01em] text-[var(--text-primary)]","children":"Warranties and disclaimer"}],[["$","p","We warrant that we will provide the Plat",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":"We warrant that we will provide the Platform in a professional manner consistent with the Agreement. EXCEPT AS EXPRESSLY STATED, THE PLATFORM AND ALL OUTPUT ARE PROVIDED “AS IS” AND “AS AVAILABLE”, AND WE DISCLAIM ALL OTHER WARRANTIES, EXPRESS OR IMPLIED, INCLUDING MERCHANTABILITY, FITNESS FOR A PARTICULAR PURPOSE, AND NON-INFRINGEMENT. We do not warrant that Output is accurate, complete, unbiased, or compliant with the laws applicable to the Customer's particular use, and Output is not legal advice. We do not guarantee any hiring, retention, or business outcome."}]]]}]
2f:["$","section","11",{"id":"clause-11","className":"relative scroll-mt-24 border-t border-[var(--border-subtle)] pl-9 pt-7 first:border-t-0 sm:pl-14 [&:not(:first-child)]:mt-9","children":[["$","span",null,{"className":"absolute left-0 top-[1.75rem] font-mono text-[13px] tabular-nums text-[var(--text-muted)] sm:text-[14px]","aria-hidden":true,"children":[11,"."]}],["$","h2",null,{"className":"m-0 font-serif text-[20px] font-bold tracking-[-0.01em] text-[var(--text-primary)]","children":"Limitation of liability"}],[["$","p","TO THE MAXIMUM EXTENT PERMITTED BY LAW, ",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":"TO THE MAXIMUM EXTENT PERMITTED BY LAW, NEITHER PARTY IS LIABLE FOR INDIRECT, INCIDENTAL, SPECIAL, CONSEQUENTIAL, OR PUNITIVE DAMAGES, OR FOR LOST PROFITS, REVENUE, OR DATA, ARISING OUT OF THE AGREEMENT. EACH PARTY'S TOTAL LIABILITY ARISING OUT OF OR RELATED TO THE AGREEMENT WILL NOT EXCEED THE AMOUNTS THE CUSTOMER PAID OR OWED US IN THE TWELVE (12) MONTHS BEFORE THE EVENT GIVING RISE TO THE LIABILITY."}],["$","p","Exclusions",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":[["$","span",null,{"className":"mr-1.5 font-mono text-[11.5px] tabular-nums text-[var(--text-muted)]","children":"11.1"}],["$","strong",null,{"className":"font-semibold text-[var(--text-primary)]","children":["Exclusions","."]}]," ","These limits do not apply to a party's liability for its breach of confidentiality, the Customer's payment obligations, a party's indemnification obligations, or liability that cannot be limited by law. The allocation of risk in this Section is a fundamental basis of the bargain."]}]]]}]
30:["$","section","12",{"id":"clause-12","className":"relative scroll-mt-24 border-t border-[var(--border-subtle)] pl-9 pt-7 first:border-t-0 sm:pl-14 [&:not(:first-child)]:mt-9","children":[["$","span",null,{"className":"absolute left-0 top-[1.75rem] font-mono text-[13px] tabular-nums text-[var(--text-muted)] sm:text-[14px]","aria-hidden":true,"children":[12,"."]}],["$","h2",null,{"className":"m-0 font-serif text-[20px] font-bold tracking-[-0.01em] text-[var(--text-primary)]","children":"Indemnification"}],[["$","p","By us",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":[["$","span",null,{"className":"mr-1.5 font-mono text-[11.5px] tabular-nums text-[var(--text-muted)]","children":"12.1"}],["$","strong",null,{"className":"font-semibold text-[var(--text-primary)]","children":["By us","."]}]," ","We will defend the Customer against a third-party claim that the Platform infringes that third party's intellectual-property rights, and pay resulting damages finally awarded, subject to the exclusions and liability limits in the Agreement."]}],["$","p","By the Customer",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":[["$","span",null,{"className":"mr-1.5 font-mono text-[11.5px] tabular-nums text-[var(--text-muted)]","children":"12.2"}],["$","strong",null,{"className":"font-semibold text-[var(--text-primary)]","children":["By the Customer","."]}]," ","The Customer will defend, indemnify, and hold us harmless from any third-party claim arising out of the Customer's employment decisions, its use of the Platform in violation of the Agreement or law, its Customer Data, or its failure to provide any required candidate notice, consent, accommodation, bias audit, or posting. This mirrors and supplements the Customer indemnity in the Fee Terms."]}]]]}]
31:["$","section","13",{"id":"clause-13","className":"relative scroll-mt-24 border-t border-[var(--border-subtle)] pl-9 pt-7 first:border-t-0 sm:pl-14 [&:not(:first-child)]:mt-9","children":[["$","span",null,{"className":"absolute left-0 top-[1.75rem] font-mono text-[13px] tabular-nums text-[var(--text-muted)] sm:text-[14px]","aria-hidden":true,"children":[13,"."]}],["$","h2",null,{"className":"m-0 font-serif text-[20px] font-bold tracking-[-0.01em] text-[var(--text-primary)]","children":"Term, suspension, and termination"}],[["$","p","Term",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":[["$","span",null,{"className":"mr-1.5 font-mono text-[11.5px] tabular-nums text-[var(--text-muted)]","children":"13.1"}],["$","strong",null,{"className":"font-semibold text-[var(--text-primary)]","children":["Term","."]}]," ","The Agreement starts when the Customer first accepts it or uses the Platform and continues until terminated. Subscriptions renew as described in the Fee Terms."]}],["$","p","Suspension",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":[["$","span",null,{"className":"mr-1.5 font-mono text-[11.5px] tabular-nums text-[var(--text-muted)]","children":"13.2"}],["$","strong",null,{"className":"font-semibold text-[var(--text-primary)]","children":["Suspension","."]}]," ","We may suspend access for a material breach, non-payment, or a security or legal risk, with notice where practicable."]}],["$","p","Termination and effect",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":[["$","span",null,{"className":"mr-1.5 font-mono text-[11.5px] tabular-nums text-[var(--text-muted)]","children":"13.3"}],["$","strong",null,{"className":"font-semibold text-[var(--text-primary)]","children":["Termination and effect","."]}]," ","Either party may terminate for the other's uncured material breach. On termination, the Customer's right to use the Platform ends, accrued fees remain payable, and each party will return or delete the other's confidential information on request, subject to law and to Customer Data handling in the Privacy Policy and DPA. Sections that by their nature should survive will survive."]}]]]}]
32:["$","section","14",{"id":"clause-14","className":"relative scroll-mt-24 border-t border-[var(--border-subtle)] pl-9 pt-7 first:border-t-0 sm:pl-14 [&:not(:first-child)]:mt-9","children":[["$","span",null,{"className":"absolute left-0 top-[1.75rem] font-mono text-[13px] tabular-nums text-[var(--text-muted)] sm:text-[14px]","aria-hidden":true,"children":[14,"."]}],["$","h2",null,{"className":"m-0 font-serif text-[20px] font-bold tracking-[-0.01em] text-[var(--text-primary)]","children":"Dispute resolution; governing law"}],[["$","p","Governing law",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":[["$","span",null,{"className":"mr-1.5 font-mono text-[11.5px] tabular-nums text-[var(--text-muted)]","children":"14.1"}],["$","strong",null,{"className":"font-semibold text-[var(--text-primary)]","children":["Governing law","."]}]," ","The Agreement is governed by the laws of the State of Delaware, excluding its conflict-of-laws rules and the U.N. Convention on Contracts for the International Sale of Goods."]}],["$","p","Informal resolution",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":[["$","span",null,{"className":"mr-1.5 font-mono text-[11.5px] tabular-nums text-[var(--text-muted)]","children":"14.2"}],["$","strong",null,{"className":"font-semibold text-[var(--text-primary)]","children":["Informal resolution","."]}]," ","Before starting a formal proceeding, the parties will try in good faith to resolve any dispute for thirty (30) days after written notice."]}],["$","p","Arbitration and class waiver",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":[["$","span",null,{"className":"mr-1.5 font-mono text-[11.5px] tabular-nums text-[var(--text-muted)]","children":"14.3"}],["$","strong",null,{"className":"font-semibold text-[var(--text-primary)]","children":["Arbitration and class waiver","."]}]," ","Any dispute not resolved informally will be finally settled by binding arbitration on an individual basis; the parties waive any right to a jury trial and to participate in a class or representative action, to the extent permitted by law. Either party may seek injunctive relief for intellectual-property or confidentiality matters in court. [Counsel to confirm arbitral forum, rules, seat, and any consumer/employment carve-outs.]"]}]]]}]
33:["$","section","15",{"id":"clause-15","className":"relative scroll-mt-24 border-t border-[var(--border-subtle)] pl-9 pt-7 first:border-t-0 sm:pl-14 [&:not(:first-child)]:mt-9","children":[["$","span",null,{"className":"absolute left-0 top-[1.75rem] font-mono text-[13px] tabular-nums text-[var(--text-muted)] sm:text-[14px]","aria-hidden":true,"children":[15,"."]}],["$","h2",null,{"className":"m-0 font-serif text-[20px] font-bold tracking-[-0.01em] text-[var(--text-primary)]","children":"Changes to these Terms"}],[["$","p","We may update these Terms from time to t",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":"We may update these Terms from time to time. The current version and its effective date are shown at the top of this page, and prior versions are available in the Legal Updates archive. For material changes we will provide reasonable advance notice; continued use after the changes take effect constitutes acceptance. No change applies retroactively to obligations already accrued."}]]]}]
34:["$","section","16",{"id":"clause-16","className":"relative scroll-mt-24 border-t border-[var(--border-subtle)] pl-9 pt-7 first:border-t-0 sm:pl-14 [&:not(:first-child)]:mt-9","children":[["$","span",null,{"className":"absolute left-0 top-[1.75rem] font-mono text-[13px] tabular-nums text-[var(--text-muted)] sm:text-[14px]","aria-hidden":true,"children":[16,"."]}],["$","h2",null,{"className":"m-0 font-serif text-[20px] font-bold tracking-[-0.01em] text-[var(--text-primary)]","children":"General"}],[["$","p","Entire agreement; order of precedence",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":[["$","span",null,{"className":"mr-1.5 font-mono text-[11.5px] tabular-nums text-[var(--text-muted)]","children":"16.1"}],["$","strong",null,{"className":"font-semibold text-[var(--text-primary)]","children":["Entire agreement; order of precedence","."]}]," ","The Agreement is the entire agreement on its subject and supersedes prior discussions. If there is a conflict, the order of precedence is: an executed order form, the Fee Terms and Fee Schedule (for billing), these Terms, and then the incorporated policies — except where a document expressly overrides a specific provision."]}],["$","p","Assignment; miscellaneous",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":[["$","span",null,{"className":"mr-1.5 font-mono text-[11.5px] tabular-nums text-[var(--text-muted)]","children":"16.2"}],["$","strong",null,{"className":"font-semibold text-[var(--text-primary)]","children":["Assignment; miscellaneous","."]}]," ","The Customer may not assign the Agreement without our consent; we may assign it to an affiliate or in a merger or asset sale. If any provision is unenforceable it will be limited or severed and the rest remains in effect. A failure to enforce is not a waiver. Notices to us may be sent to contact@emergences.ai. There are no third-party beneficiaries."]}]]]}]
