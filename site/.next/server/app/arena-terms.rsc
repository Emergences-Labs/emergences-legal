1d:["$","section","3",{"id":"clause-3","className":"relative scroll-mt-24 border-t border-[var(--border-subtle)] pl-9 pt-7 first:border-t-0 sm:pl-14 [&:not(:first-child)]:mt-9","children":[["$","span",null,{"className":"absolute left-0 top-[1.75rem] font-mono text-[13px] tabular-nums text-[var(--text-muted)] sm:text-[14px]","aria-hidden":true,"children":[3,"."]}],["$","h2",null,{"className":"m-0 font-serif text-[20px] font-bold tracking-[-0.01em] text-[var(--text-primary)]","children":"Your work"}],[["$","p","You keep ownership of the work you submi",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":"You keep ownership of the work you submit. You grant NeoWork and the Company a license to use it for evaluating your attempt, operating and improving the assessment service, and — where you keep the public profile option on — presenting derived scores and levels on your pseudonymous profile. Neither NeoWork nor the Company may pass your submission off as its own deliverable."}],["$","p","Your submission is never published publi",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":"Your submission is never published publicly and never placed under an open license. Unlike open-competition platforms, your work stays between you, the Company, and NeoWork — only derived scores can appear publicly, pseudonymously, and only if you keep the profile option on."}],["$","p","Submit only work you are allowed to shar",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":"Submit only work you are allowed to share: no confidential material from an employer, no other people's personal data, and no content you don't have rights to."}]]]}]
1e:["$","section","4",{"id":"clause-4","className":"relative scroll-mt-24 border-t border-[var(--border-subtle)] pl-9 pt-7 first:border-t-0 sm:pl-14 [&:not(:first-child)]:mt-9","children":[["$","span",null,{"className":"absolute left-0 top-[1.75rem] font-mono text-[13px] tabular-nums text-[var(--text-muted)] sm:text-[14px]","aria-hidden":true,"children":[4,"."]}],["$","h2",null,{"className":"m-0 font-serif text-[20px] font-bold tracking-[-0.01em] text-[var(--text-primary)]","children":"Your public profile"}],[["$","p","If you keep the profile option on at sta",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":"If you keep the profile option on at start, your verified scores appear on a pseudonymous NeoHuman profile and on the public leaderboards — under a generated handle, never your name. Your work products, the assessment contents, and the Company's identity in relation to your attempt are not published."}],["$","p","You can decline the profile at start, or",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":"You can decline the profile at start, or unpublish at any time from your profile's manage view. Unpublishing removes your profile and board rows from public view; the Company you applied to keeps your report."}]]]}]
1f:["$","section","5",{"id":"clause-5","className":"relative scroll-mt-24 border-t border-[var(--border-subtle)] pl-9 pt-7 first:border-t-0 sm:pl-14 [&:not(:first-child)]:mt-9","children":[["$","span",null,{"className":"absolute left-0 top-[1.75rem] font-mono text-[13px] tabular-nums text-[var(--text-muted)] sm:text-[14px]","aria-hidden":true,"children":[5,"."]}],["$","h2",null,{"className":"m-0 font-serif text-[20px] font-bold tracking-[-0.01em] text-[var(--text-primary)]","children":"Fair play"}],[["$","ul","One identity: don't take assessments und",{"className":"mt-3 list-disc space-y-2 pl-5 text-[14px] leading-[1.75] text-[var(--text-secondary)] marker:text-[var(--brand)]","children":[["$","li","One identity: don't take assessments under multiple emails or on someone else's behalf.",{"children":"One identity: don't take assessments under multiple emails or on someone else's behalf."}],["$","li","Your own effort: AI tools are expected, but the directing judgment must be yours — no outsourcing the attempt to another person.",{"children":"Your own effort: AI tools are expected, but the directing judgment must be yours — no outsourcing the attempt to another person."}],["$","li","No probing: don't attempt to extract assessment materials, scoring logic, or other takers' data.",{"children":"No probing: don't attempt to extract assessment materials, scoring logic, or other takers' data."}]]}],["$","p","We may invalidate attempts and remove pr",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":"We may invalidate attempts and remove profiles that break these rules, and may pause or close postings at any time."}]]]}]
20:["$","section","6",{"id":"clause-6","className":"relative scroll-mt-24 border-t border-[var(--border-subtle)] pl-9 pt-7 first:border-t-0 sm:pl-14 [&:not(:first-child)]:mt-9","children":[["$","span",null,{"className":"absolute left-0 top-[1.75rem] font-mono text-[13px] tabular-nums text-[var(--text-muted)] sm:text-[14px]","aria-hidden":true,"children":[6,"."]}],["$","h2",null,{"className":"m-0 font-serif text-[20px] font-bold tracking-[-0.01em] text-[var(--text-primary)]","children":"Your data"}],[["$","p","The Candidate Privacy Notice describes w",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":"The Candidate Privacy Notice describes what is collected, how the AI evaluation works, retention, and your rights (access, correction, deletion, human review). For an Arena attempt, the Company is the controller of the results it receives; NeoWork processes your data to run the assessment and, where you opt in, to operate your public profile. If you never complete the attempt, your contact details are removed when the posting closes."}]]]}]
