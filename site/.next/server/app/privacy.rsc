n-top leading-[1.6] text-[var(--text-secondary)]","children":"identity-provider subject, verified email domain, directory attributes"}],["$","td","2",{"className":"py-2.5 pr-4 align-top leading-[1.6] text-[var(--text-secondary)]","children":"Customer Users"}],["$","td","3",{"className":"py-2.5 pr-4 align-top leading-[1.6] text-[var(--text-secondary)]","children":"Your organization's IdP"}]]}],["$","tr","Billing & commercial|plan, payment-processor ide",{"className":"border-b border-[var(--border-subtle)] last:border-0 print:break-inside-avoid","children":[["$","td","0",{"className":"py-2.5 pr-4 align-top leading-[1.6] font-medium text-[var(--text-primary)]","children":"Billing & commercial"}],["$","td","1",{"className":"py-2.5 pr-4 align-top leading-[1.6] text-[var(--text-secondary)]","children":"plan, payment-processor identifiers, invoices, salary basis for the placement fee"}],["$","td","2",{"className":"py-2.5 pr-4 align-top leading-[1.6] text-[var(--text-secondary)]","children":"Customer Users"}],["$","td","3",{"className":"py-2.5 pr-4 align-top leading-[1.6] text-[var(--text-secondary)]","children":"You / payment processor"}]]}],["$","tr","Usage & security metadata|IP address, device/bro",{"className":"border-b border-[var(--border-subtle)] last:border-0 print:break-inside-avoid","children":[["$","td","0",{"className":"py-2.5 pr-4 align-top leading-[1.6] font-medium text-[var(--text-primary)]","children":"Usage & security metadata"}],["$","td","1",{"className":"py-2.5 pr-4 align-top leading-[1.6] text-[var(--text-secondary)]","children":"IP address, device/browser, audit and rate-limit logs"}],["$","td","2",{"className":"py-2.5 pr-4 align-top leading-[1.6] text-[var(--text-secondary)]","children":"Customer Users & Candidates"}],"$L32"]}],"$L33","$L34","$L35","$L36","$L37","$L38"]}]]}]
25:["$","aside","callout-Third-party sourcing",{"className":"mt-5 rounded-[var(--radius-lg)] border border-[var(--border-subtle)] border-l-2 border-l-[var(--brand)] bg-[var(--surface-inset)] px-5 py-4 print:break-inside-avoid","children":[["$","p",null,{"className":"m-0 font-mono text-[10.5px] uppercase tracking-[0.12em] text-[var(--text-muted)]","children":"Third-party sourcing"}],["$","p",null,{"className":"mt-2 text-[13.5px] leading-[1.7] text-[var(--text-secondary)] [text-wrap:pretty]","children":"Some Candidate profile data is enriched from a third-party professional-data provider using a professional-profile URL, rather than collected from the Candidate. Where we obtain personal data indirectly, we provide the transparency the law requires and identify the source category in the Candidate Privacy Notice."}]]}]
26:["$","section","3",{"id":"clause-3","className":"relative scroll-mt-24 border-t border-[var(--border-subtle)] pl-9 pt-7 first:border-t-0 sm:pl-14 [&:not(:first-child)]:mt-9","children":[["$","span",null,{"className":"absolute left-0 top-[1.75rem] font-mono text-[13px] tabular-nums text-[var(--text-muted)] sm:text-[14px]","aria-hidden":true,"children":[3,"."]}],["$","h2",null,{"className":"m-0 font-serif text-[20px] font-bold tracking-[-0.01em] text-[var(--text-primary)]","children":"How we use personal data"}],[["$","ul","Provide, operate, secure, and improve th",{"className":"mt-3 list-disc space-y-2 pl-5 text-[14px] leading-[1.75] text-[var(--text-secondary)] marker:text-[var(--brand)]","children":[["$","li","Provide, operate, secure, and improve the Platform.",{"children":"Provide, operate, secure, and improve the Platform."}],["$","li","Create and evaluate assessments and generate descriptive reports on an employer's instruction.",{"children":"Create and evaluate assessments and generate descriptive reports on an employer's instruction."}],["$","li","Authenticate users, enforce access controls, and prevent fraud and abuse.",{"children":"Authenticate users, enforce access controls, and prevent fraud and abuse."}],["$","li","Process subscriptions, credits, and placement-fee invoices.",{"children":"Process subscriptions, credits, and placement-fee invoices."}],["$","li","Communicate about the service, including transactional and administrative messages.",{"children":"Communicate about the service, including transactional and administrative messages."}],["$","li","Comply with legal obligations and enforce our agreements.",{"children":"Comply with legal obligations and enforce our agreements."}]]}],["$","p","We do not sell personal data, and we do ",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":"We do not sell personal data, and we do not use Candidate assessment content to train general-purpose AI models for unrelated purposes."}]]]}]
27:["$","section","4",{"id":"clause-4","className":"relative scroll-mt-24 border-t border-[var(--border-subtle)] pl-9 pt-7 first:border-t-0 sm:pl-14 [&:not(:first-child)]:mt-9","children":[["$","span",null,{"className":"absolute left-0 top-[1.75rem] font-mono text-[13px] tabular-nums text-[var(--text-muted)] sm:text-[14px]","aria-hidden":true,"children":[4,"."]}],["$","h2",null,{"className":"m-0 font-serif text-[20px] font-bold tracking-[-0.01em] text-[var(--text-primary)]","children":"Automated evaluation and AI"}],[["$","p","The Platform uses AI to evaluate a Candi",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":"The Platform uses AI to evaluate a Candidate's work and produce descriptive assessment outputs. These outputs are a decision-support input: the Platform does not make hiring decisions and does not label a Candidate “hire” or “no-hire”. The employer applies human review and makes every employment decision."}],["$","p","Because an automated evaluation can sign",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":"Because an automated evaluation can significantly affect a Candidate, we support the employer in providing notice of AI use, a route to human review and to contest an outcome, and a reasonable accommodation or alternative process on request. These rights and how to exercise them are described in the Candidate Privacy Notice and the Candidate Bill of Rights."}]]]}]
28:["$","section","5",{"id":"clause-5","className":"relative scroll-mt-24 border-t border-[var(--border-subtle)] pl-9 pt-7 first:border-t-0 sm:pl-14 [&:not(:first-child)]:mt-9","children":[["$","span",null,{"className":"absolute left-0 top-[1.75rem] font-mono text-[13px] tabular-nums text-[var(--text-muted)] sm:text-[14px]","aria-hidden":true,"children":[5,"."]}],["$","h2",null,{"className":"m-0 font-serif text-[20px] font-bold tracking-[-0.01em] text-[var(--text-primary)]","children":"Legal bases (EEA/UK)"}],[["$","p","Where the GDPR or UK GDPR applies to pro",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":"Where the GDPR or UK GDPR applies to processing for which we are the controller, we rely on: performance of a contract (to provide the Platform to Customer Users); our legitimate interests (to secure and improve the Platform and prevent abuse), balanced against your rights; compliance with a legal obligation; and consent where required (for example, non-essential cookies). Where we act as a processor of Candidate data, the employer is responsible for the lawful basis of that processing."}]]]}]
29:["$","section","6",{"id":"clause-6","className":"relative scroll-mt-24 border-t border-[var(--border-subtle)] pl-9 pt-7 first:border-t-0 sm:pl-14 [&:not(:first-child)]:mt-9","children":[["$","span",null,{"className":"absolute left-0 top-[1.75rem] font-mono text-[13px] tabular-nums text-[var(--text-muted)] sm:text-[14px]","aria-hidden":true,"children":[6,"."]}],["$","h2",null,{"className":"m-0 font-serif text-[20px] font-bold tracking-[-0.01em] text-[var(--text-primary)]","children":"How we share personal data"}],[["$","p","Sub-processors",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":[["$","span",null,{"className":"mr-1.5 font-mono text-[11.5px] tabular-nums text-[var(--text-muted)]","children":"6.1"}],["$","strong",null,{"className":"font-semibold text-[var(--text-primary)]","children":["Sub-processors","."]}]," ","We share personal data with vetted service providers who process it on our behalf under contract — for hosting, database and storage, authentication, AI model inference, payment processing, email, error monitoring, and code execution. Our current sub-processors are listed on the Sub-processors page, which you can subscribe to for change notices."]}],["$","p","Within the hiring process",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":[["$","span",null,{"className":"mr-1.5 font-mono text-[11.5px] tabular-nums text-[var(--text-muted)]","children":"6.2"}],["$","strong",null,{"className":"font-semibold text-[var(--text-primary)]","children":["Within the hiring process","."]}]," ","Candidate data and evaluation outputs are shared with the employer that runs the assessment, which is their intended purpose."]}],["$","p","Legal and corporate",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":[["$","span",null,{"className":"mr-1.5 font-mono text-[11.5px] tabular-nums text-[var(--text-muted)]","children":"6.3"}],["$","strong",null,{"className":"font-semibold text-[var(--text-primary)]","children":["Legal and corporate","."]}]," ","We may disclose data to comply with law or valid legal process (per our Law-Enforcement Request Policy), to protect rights and safety, or in connection with a merger, acquisition, or asset sale, subject to this Policy."]}]]]}]
2a:["$","section","7",{"id":"clause-7","className":"relative scroll-mt-24 border-t border-[var(--border-subtle)] pl-9 pt-7 first:border-t-0 sm:pl-14 [&:not(:first-child)]:mt-9","children":[["$","span",null,{"className":"absolute left-0 top-[1.75rem] font-mono text-[13px] tabular-nums text-[var(--text-muted)] sm:text-[14px]","aria-hidden":true,"children":[7,"."]}],["$","h2",null,{"className":"m-0 font-serif text-[20px] font-bold tracking-[-0.01em] text-[var(--text-primary)]","children":"International transfers"}],[["$","p","We are based in the United States and us",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":"We are based in the United States and use sub-processors in the United States and elsewhere. Where we transfer personal data out of the EEA, UK, or Switzerland, we rely on an appropriate transfer mechanism — such as the European Commission's Standard Contractual Clauses and the UK Addendum — together with supplementary measures where needed. A copy of the relevant safeguards is available on request via our Data Processing Addendum."}]]]}]
2b:["$","section","8",{"id":"clause-8","className":"relative scroll-mt-24 border-t border-[var(--border-subtle)] pl-9 pt-7 first:border-t-0 sm:pl-14 [&:not(:first-child)]:mt-9","children":[["$","span",null,{"className":"absolute left-0 top-[1.75rem] font-mono text-[13px] tabular-nums text-[var(--text-muted)] sm:text-[14px]","aria-hidden":true,"children":[8,"."]}],["$","h2",null,{"className":"m-0 font-serif text-[20px] font-bold tracking-[-0.01em] text-[var(--text-primary)]","children":"Retention"}],[["$","p","We keep personal data for as long as nee",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":"We keep personal data for as long as needed to provide the Platform and for legitimate business and legal purposes, then delete or de-identify it. Customer Users' account data is retained for the life of the account and deleted on request or after closure, subject to records we must keep (for example, invoices). For Candidate data, retention is governed by the employer's instructions and our Data Retention & Deletion Policy. Specific retention periods are set out in that Policy."}]]]}]
2c:["$","section","9",{"id":"clause-9","className":"relative scroll-mt-24 border-t border-[var(--border-subtle)] pl-9 pt-7 first:border-t-0 sm:pl-14 [&:not(:first-child)]:mt-9","children":[["$","span",null,{"className":"absolute left-0 top-[1.75rem] font-mono text-[13px] tabular-nums text-[var(--text-muted)] sm:text-[14px]","aria-hidden":true,"children":[9,"."]}],["$","h2",null,{"className":"m-0 font-serif text-[20px] font-bold tracking-[-0.01em] text-[var(--text-primary)]","children":"Security"}],[["$","p","We use administrative, technical, and or",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":"We use administrative, technical, and organizational measures appropriate to the risk — including encryption in transit and at rest, tenant isolation, least-privilege access controls, audit logging, and monitoring. No method of transmission or storage is perfectly secure; if a breach affects your personal data we will notify affected parties as required by law and our agreements. Our security posture is summarized on our Trust page."}]]]}]
2d:["$","section","10",{"id":"clause-10","className":"relative scroll-mt-24 border-t border-[var(--border-subtle)] pl-9 pt-7 first:border-t-0 sm:pl-14 [&:not(:first-child)]:mt-9","children":[["$","span",null,{"className":"absolute left-0 top-[1.75rem] font-mono text-[13px] tabular-nums text-[var(--text-muted)] sm:text-[14px]","aria-hidden":true,"children":[10,"."]}],["$","h2",null,{"className":"m-0 font-serif text-[20px] font-bold tracking-[-0.01em] text-[var(--text-primary)]","children":"Your rights and choices"}],[["$","p","Depending on where you live, you may hav",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":"Depending on where you live, you may have rights to access, correct, delete, port, or restrict personal data, to object to certain processing, and to withdraw consent. You may also have the right not to be subject to a solely automated decision with legal or similarly significant effect, and to obtain human review."}],["$","p","How to exercise them",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":[["$","span",null,{"className":"mr-1.5 font-mono text-[11.5px] tabular-nums text-[var(--text-muted)]","children":"10.1"}],["$","strong",null,{"className":"font-semibold text-[var(--text-primary)]","children":["How to exercise them","."]}]," ","Customer Users can manage much of their data in the Platform, or contact us at contact@emergences.ai. Candidates should contact the employer that invited them (the controller); we will assist that employer in responding. We verify requests and respond within the period the applicable law requires, and we will not discriminate against you for exercising a right."]}],["$","p","California",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":[["$","span",null,{"className":"mr-1.5 font-mono text-[11.5px] tabular-nums text-[var(--text-muted)]","children":"10.2"}],["$","strong",null,{"className":"font-semibold text-[var(--text-primary)]","children":["California","."]}]," ","California residents have rights under the CCPA/CPRA to know, delete, correct, and to opt out of “sale” or “sharing” of personal information. We do not sell personal information and do not share it for cross-context behavioral advertising. You can still exercise your choices via the “Your Privacy Choices” link, and we honor recognized opt-out preference signals such as Global Privacy Control."]}]]]}]
2e:["$","section","11",{"id":"clause-11","className":"relative scroll-mt-24 border-t border-[var(--border-subtle)] pl-9 pt-7 first:border-t-0 sm:pl-14 [&:not(:first-child)]:mt-9","children":[["$","span",null,{"className":"absolute left-0 top-[1.75rem] font-mono text-[13px] tabular-nums text-[var(--text-muted)] sm:text-[14px]","aria-hidden":true,"children":[11,"."]}],["$","h2",null,{"className":"m-0 font-serif text-[20px] font-bold tracking-[-0.01em] text-[var(--text-primary)]","children":"Cookies and similar technologies"}],[["$","p","We use strictly necessary cookies to run",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":"We use strictly necessary cookies to run the Platform (for example, authentication and session security) and, with consent where required, limited analytics and error-monitoring technologies. You can manage non-essential cookies through the consent banner and the cookie-preferences link. See our Cookie Policy for details."}]]]}]
2f:["$","section","12",{"id":"clause-12","className":"relative scroll-mt-24 border-t border-[var(--border-subtle)] pl-9 pt-7 first:border-t-0 sm:pl-14 [&:not(:first-child)]:mt-9","children":[["$","span",null,{"className":"absolute left-0 top-[1.75rem] font-mono text-[13px] tabular-nums text-[var(--text-muted)] sm:text-[14px]","aria-hidden":true,"children":[12,"."]}],["$","h2",null,{"className":"m-0 font-serif text-[20px] font-bold tracking-[-0.01em] text-[var(--text-primary)]","children":"Children"}],[["$","p","The Platform is intended for use by adul",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":"The Platform is intended for use by adults in a professional hiring context and is not directed to children. We do not knowingly collect personal data from anyone under 16. An employer that assesses early-career Candidates who may be minors is responsible for any additional consent the law requires."}]]]}]
30:["$","section","13",{"id":"clause-13","className":"relative scroll-mt-24 border-t border-[var(--border-subtle)] pl-9 pt-7 first:border-t-0 sm:pl-14 [&:not(:first-child)]:mt-9","children":[["$","span",null,{"className":"absolute left-0 top-[1.75rem] font-mono text-[13px] tabular-nums text-[var(--text-muted)] sm:text-[14px]","aria-hidden":true,"children":[13,"."]}],["$","h2",null,{"className":"m-0 font-serif text-[20px] font-bold tracking-[-0.01em] text-[var(--text-primary)]","children":"Changes to this Policy"}],[["$","p","We may update this Policy from time to t",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":"We may update this Policy from time to time. The current version and its effective date are always shown at the top of this page, and prior versions are available in the Legal Updates archive. For material changes we will provide reasonable notice (for example, by notice in the Platform or by email)."}]]]}]
31:["$","section","14",{"id":"clause-14","className":"relative scroll-mt-24 border-t border-[var(--border-subtle)] pl-9 pt-7 first:border-t-0 sm:pl-14 [&:not(:first-child)]:mt-9","children":[["$","span",null,{"className":"absolute left-0 top-[1.75rem] font-mono text-[13px] tabular-nums text-[var(--text-muted)] sm:text-[14px]","aria-hidden":true,"children":[14,"."]}],["$","h2",null,{"className":"m-0 font-serif text-[20px] font-bold tracking-[-0.01em] text-[var(--text-primary)]","children":"Contact us"}],[["$","p","You can reach us about privacy at contac",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":"You can reach us about privacy at contact@emergences.ai. If you are in the EEA or UK, you also have the right to lodge a complaint with your local supervisory authority. Our privacy and data-protection contact for formal requests is available at the same address."}]]]}]
