22:["$","p","Data we collect automatically",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":[["$","span",null,{"className":"mr-1.5 font-mono text-[11.5px] tabular-nums text-[var(--text-muted)]","children":"3.2"}],["$","strong",null,{"className":"font-semibold text-[var(--text-primary)]","children":["Data we collect automatically","."]}]," ","We collect standard web log data such as your IP address, browser type, the pages you view, and the page that referred you, and — where you allow it — website analytics as described below. Our website host processes this data to serve and secure the site."]}]
