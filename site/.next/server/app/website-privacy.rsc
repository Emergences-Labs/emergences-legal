25:["$","section","5",{"id":"clause-5","className":"relative scroll-mt-24 border-t border-[var(--border-subtle)] pl-9 pt-7 first:border-t-0 sm:pl-14 [&:not(:first-child)]:mt-9","children":[["$","span",null,{"className":"absolute left-0 top-[1.75rem] font-mono text-[13px] tabular-nums text-[var(--text-muted)] sm:text-[14px]","aria-hidden":true,"children":[5,"."]}],["$","h2",null,{"className":"m-0 font-serif text-[20px] font-bold tracking-[-0.01em] text-[var(--text-primary)]","children":"Marketing communications"}],[["$","p","We send marketing email only where the l",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":"We send marketing email only where the law allows, and with your consent where it is required. Every marketing message includes an unsubscribe link. A direct reply to an inquiry you sent us is not marketing."}]]]}]
26:["$","section","6",{"id":"clause-6","className":"relative scroll-mt-24 border-t border-[var(--border-subtle)] pl-9 pt-7 first:border-t-0 sm:pl-14 [&:not(:first-child)]:mt-9","children":[["$","span",null,{"className":"absolute left-0 top-[1.75rem] font-mono text-[13px] tabular-nums text-[var(--text-muted)] sm:text-[14px]","aria-hidden":true,"children":[6,"."]}],["$","h2",null,{"className":"m-0 font-serif text-[20px] font-bold tracking-[-0.01em] text-[var(--text-primary)]","children":"Cookies and analytics"}],[["$","p","This site uses strictly necessary cookie",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":"This site uses strictly necessary cookies so that it loads, works, and stays secure. Where you allow it, we also use website analytics to understand aggregate usage — which pages are read, and how people arrive."}],["$","p","We use no advertising cookies and no cro",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":"We use no advertising cookies and no cross-site tracking on this website. Analytics cookies are set only with your consent, you can withdraw that consent at any time, and withdrawing it does not affect your ability to use the site."}]]]}]
27:["$","section","7",{"id":"clause-7","className":"relative scroll-mt-24 border-t border-[var(--border-subtle)] pl-9 pt-7 first:border-t-0 sm:pl-14 [&:not(:first-child)]:mt-9","children":[["$","span",null,{"className":"absolute left-0 top-[1.75rem] font-mono text-[13px] tabular-nums text-[var(--text-muted)] sm:text-[14px]","aria-hidden":true,"children":[7,"."]}],["$","h2",null,{"className":"m-0 font-serif text-[20px] font-bold tracking-[-0.01em] text-[var(--text-primary)]","children":"Who we share your data with"}],[["$","p","We share personal data with service prov",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":"We share personal data with service providers that host and operate this site and our business systems, including Framer (website hosting) and Google Workspace (email), along with the tools we use to handle inquiries and job applications. These providers process data under contract for us."}],["$","p","We also share data with professional adv",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":"We also share data with professional advisers and authorities where the law requires, and with a successor entity in the event of a merger, acquisition, or asset sale, with notice where required."}],["$","aside","callout-We do not sell",{"className":"mt-5 rounded-[var(--radius-lg)] border border-[var(--border-subtle)] border-l-2 border-l-[var(--brand)] bg-[var(--surface-inset)] px-5 py-4 print:break-inside-avoid","children":[["$","p",null,{"className":"m-0 font-mono text-[10.5px] uppercase tracking-[0.12em] text-[var(--text-muted)]","children":"We do not sell"}],["$","p",null,{"className":"mt-2 text-[13.5px] leading-[1.7] text-[var(--text-secondary)] [text-wrap:pretty]","children":"We do not sell personal information, and we do not share it for cross-context behavioral advertising, as those terms are defined by the CCPA and CPRA."}]]}]]]}]
28:["$","section","8",{"id":"clause-8","className":"relative scroll-mt-24 border-t border-[var(--border-subtle)] pl-9 pt-7 first:border-t-0 sm:pl-14 [&:not(:first-child)]:mt-9","children":[["$","span",null,{"className":"absolute left-0 top-[1.75rem] font-mono text-[13px] tabular-nums text-[var(--text-muted)] sm:text-[14px]","aria-hidden":true,"children":[8,"."]}],["$","h2",null,{"className":"m-0 font-serif text-[20px] font-bold tracking-[-0.01em] text-[var(--text-primary)]","children":"International transfers"}],[["$","p","We are based in the United States and pr",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":"We are based in the United States and process data there. Where we receive personal data from the EEA, the UK, or Switzerland, we rely on appropriate safeguards, such as the European Commission's Standard Contractual Clauses, to protect it."}]]]}]
29:["$","section","9",{"id":"clause-9","className":"relative scroll-mt-24 border-t border-[var(--border-subtle)] pl-9 pt-7 first:border-t-0 sm:pl-14 [&:not(:first-child)]:mt-9","children":[["$","span",null,{"className":"absolute left-0 top-[1.75rem] font-mono text-[13px] tabular-nums text-[var(--text-muted)] sm:text-[14px]","aria-hidden":true,"children":[9,"."]}],["$","h2",null,{"className":"m-0 font-serif text-[20px] font-bold tracking-[-0.01em] text-[var(--text-primary)]","children":"Retention"}],[["$","p","We keep inquiries and correspondence for",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":"We keep inquiries and correspondence for as long as we need to handle them and for a reasonable period afterwards. We keep applicant data for the recruitment process and for up to 12 months afterwards, or longer if you agree to be considered for future roles."}],["$","p","We keep web server logs and analytics da",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":"We keep web server logs and analytics data only as long as we need them to secure the site and measure aggregate usage, and delete or aggregate them after that."}]]]}]
2a:["$","section","10",{"id":"clause-10","className":"relative scroll-mt-24 border-t border-[var(--border-subtle)] pl-9 pt-7 first:border-t-0 sm:pl-14 [&:not(:first-child)]:mt-9","children":[["$","span",null,{"className":"absolute left-0 top-[1.75rem] font-mono text-[13px] tabular-nums text-[var(--text-muted)] sm:text-[14px]","aria-hidden":true,"children":[10,"."]}],["$","h2",null,{"className":"m-0 font-serif text-[20px] font-bold tracking-[-0.01em] text-[var(--text-primary)]","children":"Your rights and choices"}],[["$","ul","Access the personal data we hold about y",{"className":"mt-3 list-disc space-y-2 pl-5 text-[14px] leading-[1.75] text-[var(--text-secondary)] marker:text-[var(--brand)]","children":[["$","li","Access the personal data we hold about you, and receive a copy.",{"children":"Access the personal data we hold about you, and receive a copy."}],["$","li","Correct inaccurate data, or ask us to delete it.",{"children":"Correct inaccurate data, or ask us to delete it."}],["$","li","Object to or restrict certain processing, and withdraw consent you gave.",{"children":"Object to or restrict certain processing, and withdraw consent you gave."}],["$","li","Receive your data in a portable form where that right applies.",{"children":"Receive your data in a portable form where that right applies."}]]}],["$","p","California",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":[["$","span",null,{"className":"mr-1.5 font-mono text-[11.5px] tabular-nums text-[var(--text-muted)]","children":"10.1"}],["$","strong",null,{"className":"font-semibold text-[var(--text-primary)]","children":["California","."]}]," ","California residents have the rights to know, delete, and correct, and the right to opt out of the sale or sharing of personal information. As stated above, we do not sell or share personal information for cross-context behavioral advertising, so there is nothing to opt out of on this website. We will not treat you differently for exercising any right."]}],["$","p","How to exercise them",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":[["$","span",null,{"className":"mr-1.5 font-mono text-[11.5px] tabular-nums text-[var(--text-muted)]","children":"10.2"}],["$","strong",null,{"className":"font-semibold text-[var(--text-primary)]","children":["How to exercise them","."]}]," ","Email contact@emergences.ai. If your request concerns an assessment you completed for a hiring organization, we will route it as described in the Candidate Privacy Notice — in most cases that organization is the controller, and we will refer or support your request. Residents of the EEA and UK may also complain to their local supervisory authority."]}]]]}]
