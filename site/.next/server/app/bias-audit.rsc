12:["$","div",null,{"className":"mt-10","children":[["$","section","1",{"id":"clause-1","className":"relative scroll-mt-24 border-t border-[var(--border-subtle)] pl-9 pt-7 first:border-t-0 sm:pl-14 [&:not(:first-child)]:mt-9","children":[["$","span",null,{"className":"absolute left-0 top-[1.75rem] font-mono text-[13px] tabular-nums text-[var(--text-muted)] sm:text-[14px]","aria-hidden":true,"children":[1,"."]}],["$","h2",null,{"className":"m-0 font-serif text-[20px] font-bold tracking-[-0.01em] text-[var(--text-primary)]","children":"What a bias audit measures"}],[["$","p","An independent bias audit examines wheth",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":"An independent bias audit examines whether the tool's outcomes differ across demographic groups. Because our assessment produces a score, the audit computes, for each group, the rate at which candidates are scored at or above the selection threshold the employer uses (the “selection rate”), and the ratio of each group's selection rate to that of the highest-scoring group (the “impact ratio”). An impact ratio below 0.80 — the U.S. Equal Employment Opportunity Commission's four-fifths rule of thumb — flags a potential adverse impact for closer review."}]]]}],["$","section","2",{"id":"clause-2","className":"relative scroll-mt-24 border-t border-[var(--border-subtle)] pl-9 pt-7 first:border-t-0 sm:pl-14 [&:not(:first-child)]:mt-9","children":[["$","span",null,{"className":"absolute left-0 top-[1.75rem] font-mono text-[13px] tabular-nums text-[var(--text-muted)] sm:text-[14px]","aria-hidden":true,"children":[2,"."]}],["$","h2",null,{"className":"m-0 font-serif text-[20px] font-bold tracking-[-0.01em] text-[var(--text-primary)]","children":"Categories audited"}],[["$","ul","Sex (as reported in the underlying data)",{"className":"mt-3 list-disc space-y-2 pl-5 text-[14px] leading-[1.75] text-[var(--text-secondary)] marker:text-[var(--brand)]","children":[["$","li","Sex (as reported in the underlying data).",{"children":"Sex (as reported in the underlying data)."}],["$","li","Race/ethnicity, using the U.S. EEO-1 categories.",{"children":"Race/ethnicity, using the U.S. EEO-1 categories."}],["$","li","The intersection of sex and race/ethnicity.",{"children":"The intersection of sex and race/ethnicity."}]]}],["$","p","Categories with too few records to repor",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":"Categories with too few records to report reliably are marked as such rather than shown with an unreliable number."}]]]}],["$","section","3",{"id":"clause-3","className":"relative scroll-mt-24 border-t border-[var(--border-subtle)] pl-9 pt-7 first:border-t-0 sm:pl-14 [&:not(:first-child)]:mt-9","children":[["$","span",null,{"className":"absolute left-0 top-[1.75rem] font-mono text-[13px] tabular-nums text-[var(--text-muted)] sm:text-[14px]","aria-hidden":true,"children":[3,"."]}],["$","h2",null,{"className":"m-0 font-serif text-[20px] font-bold tracking-[-0.01em] text-[var(--text-primary)]","children":"Methodology"}],[["$","ul","The audit is performed by an independent",{"className":"mt-3 list-disc space-y-2 pl-5 text-[14px] leading-[1.75] text-[var(--text-secondary)] marker:text-[var(--brand)]","children":[["$","li","The audit is performed by an independent auditor with no financial interest in the outcome.",{"children":"The audit is performed by an independent auditor with no financial interest in the outcome."}],["$","li","It uses historical outcome data where available and, where it is not, test data representative of the candidate population.",{"children":"It uses historical outcome data where available and, where it is not, test data representative of the candidate population."}],"$L19","$L1a","$L1b"]}]]]}],"$L1c","$L1d","$L1e","$L1f"]}]
