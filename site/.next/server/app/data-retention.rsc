20:["$","section","2",{"id":"clause-2","className":"relative scroll-mt-24 border-t border-[var(--border-subtle)] pl-9 pt-7 first:border-t-0 sm:pl-14 [&:not(:first-child)]:mt-9","children":[["$","span",null,{"className":"absolute left-0 top-[1.75rem] font-mono text-[13px] tabular-nums text-[var(--text-muted)] sm:text-[14px]","aria-hidden":true,"children":[2,"."]}],["$","h2",null,{"className":"m-0 font-serif text-[20px] font-bold tracking-[-0.01em] text-[var(--text-primary)]","children":"Recordings, video, and biometrics"}],[["$","p","Raw assessment recordings are the most s",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":"Raw assessment recordings are the most sensitive and shortest-lived data we hold. Our commitment is to delete them once scoring is complete, and always within 30 days of a candidate's request, and to keep the derived evaluation (not the footage) as the record of the assessment."}],["$","aside","callout-No biometric identifiers",{"className":"mt-5 rounded-[var(--radius-lg)] border border-[var(--border-subtle)] border-l-2 border-l-[var(--brand)] bg-[var(--surface-inset)] px-5 py-4 print:break-inside-avoid","children":[["$","p",null,{"className":"m-0 font-mono text-[10.5px] uppercase tracking-[0.12em] text-[var(--text-muted)]","children":"No biometric identifiers"}],["$","p",null,{"className":"mt-2 text-[13.5px] leading-[1.7] text-[var(--text-secondary)] [text-wrap:pretty]","children":"NeoWork does not extract or analyze biometric identifiers (such as facial geometry or voiceprints) from candidates. If that ever changes, such data would be governed by a published retention-and-destruction schedule and destroyed at the earlier of purpose completion or three years from the last interaction, with consent."}]]}]]]}]
21:["$","section","3",{"id":"clause-3","className":"relative scroll-mt-24 border-t border-[var(--border-subtle)] pl-9 pt-7 first:border-t-0 sm:pl-14 [&:not(:first-child)]:mt-9","children":[["$","span",null,{"className":"absolute left-0 top-[1.75rem] font-mono text-[13px] tabular-nums text-[var(--text-muted)] sm:text-[14px]","aria-hidden":true,"children":[3,"."]}],["$","h2",null,{"className":"m-0 font-serif text-[20px] font-bold tracking-[-0.01em] text-[var(--text-primary)]","children":"Legal holds override deletion"}],[["$","p","If data is relevant to an actual or anti",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":"If data is relevant to an actual or anticipated legal claim, audit, or investigation — for example, a discrimination charge or a compliance evaluation — the normal clock stops: we preserve the affected records and do not delete them until the matter is finally resolved, as the law requires, ahead of any scheduled deletion."}]]]}]
22:["$","section","4",{"id":"clause-4","className":"relative scroll-mt-24 border-t border-[var(--border-subtle)] pl-9 pt-7 first:border-t-0 sm:pl-14 [&:not(:first-child)]:mt-9","children":[["$","span",null,{"className":"absolute left-0 top-[1.75rem] font-mono text-[13px] tabular-nums text-[var(--text-muted)] sm:text-[14px]","aria-hidden":true,"children":[4,"."]}],["$","h2",null,{"className":"m-0 font-serif text-[20px] font-bold tracking-[-0.01em] text-[var(--text-primary)]","children":"Deletion on request"}],[["$","p","Customer administrators can delete their",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":"Customer administrators can delete their organization's data, which cascades to associated records and cancels billing. Candidates can request deletion via the employer or us. On a verified request we delete the personal data within the period the law requires, except where we must retain limited data for legal, tax, security, or records-keeping reasons — in which case we isolate it and stop actively using it."}]]]}]
23:["$","section","5",{"id":"clause-5","className":"relative scroll-mt-24 border-t border-[var(--border-subtle)] pl-9 pt-7 first:border-t-0 sm:pl-14 [&:not(:first-child)]:mt-9","children":[["$","span",null,{"className":"absolute left-0 top-[1.75rem] font-mono text-[13px] tabular-nums text-[var(--text-muted)] sm:text-[14px]","aria-hidden":true,"children":[5,"."]}],["$","h2",null,{"className":"m-0 font-serif text-[20px] font-bold tracking-[-0.01em] text-[var(--text-primary)]","children":"Backups and residual copies"}],[["$","p","Deleted data may persist briefly in encr",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":"Deleted data may persist briefly in encrypted backups until those backups rotate out on their normal cycle, after which it is overwritten. Backups are protected by the same access controls as production data."}]]]}]
24:["$","section","6",{"id":"clause-6","className":"relative scroll-mt-24 border-t border-[var(--border-subtle)] pl-9 pt-7 first:border-t-0 sm:pl-14 [&:not(:first-child)]:mt-9","children":[["$","span",null,{"className":"absolute left-0 top-[1.75rem] font-mono text-[13px] tabular-nums text-[var(--text-muted)] sm:text-[14px]","aria-hidden":true,"children":[6,"."]}],["$","h2",null,{"className":"m-0 font-serif text-[20px] font-bold tracking-[-0.01em] text-[var(--text-primary)]","children":"Questions"}],[["$","p","Questions about retention or deletion: c",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":"Questions about retention or deletion: contact@emergences.ai."}]]]}]
