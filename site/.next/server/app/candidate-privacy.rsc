1e:["$","section","3",{"id":"clause-3","className":"relative scroll-mt-24 border-t border-[var(--border-subtle)] pl-9 pt-7 first:border-t-0 sm:pl-14 [&:not(:first-child)]:mt-9","children":[["$","span",null,{"className":"absolute left-0 top-[1.75rem] font-mono text-[13px] tabular-nums text-[var(--text-muted)] sm:text-[14px]","aria-hidden":true,"children":[3,"."]}],["$","h2",null,{"className":"m-0 font-serif text-[20px] font-bold tracking-[-0.01em] text-[var(--text-primary)]","children":"How the AI evaluation works"}],[["$","p","The platform uses AI to review your subm",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":"The platform uses AI to review your submitted work and produce descriptive results — for example, how effectively you worked and a set of competency indicators, each supported by specific evidence from your work. It describes your demonstrated level; it does not label you “hire” or “no-hire”."}],["$","aside","callout-A human decides",{"className":"mt-5 rounded-[var(--radius-lg)] border border-[var(--border-subtle)] border-l-2 border-l-[var(--brand)] bg-[var(--surface-inset)] px-5 py-4 print:break-inside-avoid","children":[["$","p",null,{"className":"m-0 font-mono text-[10.5px] uppercase tracking-[0.12em] text-[var(--text-muted)]","children":"A human decides"}],["$","p",null,{"className":"mt-2 text-[13.5px] leading-[1.7] text-[var(--text-secondary)] [text-wrap:pretty]","children":"The evaluation is one input. A person at the Employer reviews it and makes the hiring decision. The evaluation is designed to flag uncertain observations for human review rather than penalize them, and never to infer protected characteristics."}]]}]]]}]
1f:["$","section","4",{"id":"clause-4","className":"relative scroll-mt-24 border-t border-[var(--border-subtle)] pl-9 pt-7 first:border-t-0 sm:pl-14 [&:not(:first-child)]:mt-9","children":[["$","span",null,{"className":"absolute left-0 top-[1.75rem] font-mono text-[13px] tabular-nums text-[var(--text-muted)] sm:text-[14px]","aria-hidden":true,"children":[4,"."]}],["$","h2",null,{"className":"m-0 font-serif text-[20px] font-bold tracking-[-0.01em] text-[var(--text-primary)]","children":"Why your data is used"}],[["$","p","Your data is used to run and evaluate th",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":"Your data is used to run and evaluate the assessment for the Employer's hiring decision, to keep the assessment secure and fair, and to comply with law. It is not sold, and it is not used to train general-purpose AI models for unrelated purposes."}]]]}]
20:["$","section","5",{"id":"clause-5","className":"relative scroll-mt-24 border-t border-[var(--border-subtle)] pl-9 pt-7 first:border-t-0 sm:pl-14 [&:not(:first-child)]:mt-9","children":[["$","span",null,{"className":"absolute left-0 top-[1.75rem] font-mono text-[13px] tabular-nums text-[var(--text-muted)] sm:text-[14px]","aria-hidden":true,"children":[5,"."]}],["$","h2",null,{"className":"m-0 font-serif text-[20px] font-bold tracking-[-0.01em] text-[var(--text-primary)]","children":"Your rights"}],[["$","ul","Ask for a human review of an evaluation ",{"className":"mt-3 list-disc space-y-2 pl-5 text-[14px] leading-[1.75] text-[var(--text-secondary)] marker:text-[var(--brand)]","children":[["$","li","Ask for a human review of an evaluation and an explanation of how it was reached.",{"children":"Ask for a human review of an evaluation and an explanation of how it was reached."}],["$","li","Request a reasonable accommodation, or an alternative to an AI-based assessment.",{"children":"Request a reasonable accommodation, or an alternative to an AI-based assessment."}],["$","li","Access the personal data held about you, and receive a copy.",{"children":"Access the personal data held about you, and receive a copy."}],["$","li","Correct inaccurate data, or ask for your data to be deleted.",{"children":"Correct inaccurate data, or ask for your data to be deleted."}],["$","li","Object to or restrict certain processing, and withdraw any consent you gave.",{"children":"Object to or restrict certain processing, and withdraw any consent you gave."}]]}],["$","p","How to exercise them",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":[["$","span",null,{"className":"mr-1.5 font-mono text-[11.5px] tabular-nums text-[var(--text-muted)]","children":"5.1"}],["$","strong",null,{"className":"font-semibold text-[var(--text-primary)]","children":["How to exercise them","."]}]," ","Because the Employer controls your data, the fastest route is to contact them. You can also contact NeoWork at contact@emergences.ai; we will help the Employer respond and, where we must act, respond within the time the law requires. Exercising a right will not be held against you."]}]]]}]
21:["$","section","6",{"id":"clause-6","className":"relative scroll-mt-24 border-t border-[var(--border-subtle)] pl-9 pt-7 first:border-t-0 sm:pl-14 [&:not(:first-child)]:mt-9","children":[["$","span",null,{"className":"absolute left-0 top-[1.75rem] font-mono text-[13px] tabular-nums text-[var(--text-muted)] sm:text-[14px]","aria-hidden":true,"children":[6,"."]}],["$","h2",null,{"className":"m-0 font-serif text-[20px] font-bold tracking-[-0.01em] text-[var(--text-primary)]","children":"How long your data is kept"}],[["$","p","The Employer decides how long to keep yo",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":"The Employer decides how long to keep your assessment data for its hiring process, within the limits of our Data Retention & Deletion Policy. You can ask the Employer, or us, about deletion at any time."}]]]}]
22:["$","section","7",{"id":"clause-7","className":"relative scroll-mt-24 border-t border-[var(--border-subtle)] pl-9 pt-7 first:border-t-0 sm:pl-14 [&:not(:first-child)]:mt-9","children":[["$","span",null,{"className":"absolute left-0 top-[1.75rem] font-mono text-[13px] tabular-nums text-[var(--text-muted)] sm:text-[14px]","aria-hidden":true,"children":[7,"."]}],["$","h2",null,{"className":"m-0 font-serif text-[20px] font-bold tracking-[-0.01em] text-[var(--text-primary)]","children":"Security and where data is processed"}],[["$","p","We protect your data with encryption, ac",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":"We protect your data with encryption, access controls, and monitoring, and use vetted service providers listed on our Sub-processors page. We are based in the United States and may process data there and elsewhere with appropriate safeguards."}]]]}]
23:["$","section","8",{"id":"clause-8","className":"relative scroll-mt-24 border-t border-[var(--border-subtle)] pl-9 pt-7 first:border-t-0 sm:pl-14 [&:not(:first-child)]:mt-9","children":[["$","span",null,{"className":"absolute left-0 top-[1.75rem] font-mono text-[13px] tabular-nums text-[var(--text-muted)] sm:text-[14px]","aria-hidden":true,"children":[8,"."]}],["$","h2",null,{"className":"m-0 font-serif text-[20px] font-bold tracking-[-0.01em] text-[var(--text-primary)]","children":"Contact"}],[["$","p","Questions about your data on NeoWork: co",{"className":"mt-4 text-[14px] leading-[1.75] text-[var(--text-secondary)] [text-wrap:pretty]","children":"Questions about your data on NeoWork: contact@emergences.ai. If you are in the EEA or UK, you may also contact your local data-protection authority. For decisions about a specific role, contact the Employer that invited you."}]]]}]
